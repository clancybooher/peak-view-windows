{
  "name": "peak-view-windows",
  "compatibility_date": "2026-05-21",
  "main": "worker.js",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "peakvieworegon.com", "custom_domain": true },
    { "pattern": "www.peakvieworegon.com", "custom_domain": true }
  ]
}
