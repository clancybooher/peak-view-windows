# ─── Peak View Windows — Environment Variables ─────────────────────────────
# Copy this file to .dev.vars for local Wrangler development.
# In production, add these in Cloudflare Pages dashboard:
#   Your Pages project → Settings → Environment variables

# Resend API key — get from resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your email address — notification emails go here (optional; clancybooher@gmail.com is always included)
MY_EMAIL=clancy@peakvieworegon.com

# Cloudflare Turnstile secret key — get from dash.cloudflare.com → Turnstile
CLOUDFLARE_TURNSTILE_SECRET=0x4AAAAAAAAxxxxxxxxxxxxxxxxxxxxxxxx

# (Optional) Restrict CORS to your production domain
ALLOWED_ORIGIN=https://peakvieworegon.com

# ─── Quo / OpenPhone SMS ──────────────────────────────────────────────────────
# app.openphone.com → Settings → API → create a key
QUO_API_KEY=your_openphone_api_key_here

# Your Quo/OpenPhone number in E.164 format (the number you send FROM)
QUO_FROM_NUMBER=+15416393968

# Your personal number to receive lead texts (E.164 format)
MY_PHONE_NUMBER=+15415550000
